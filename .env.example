# Local server
PORT=3000

# G+D Netcetera Click to Pay SRCI SDK (<click-to-pay> web component)
# sandbox or production; maps to the sandbox="true|false" attribute
CTP_ENVIRONMENT=sandbox
# The SDK is served from the npm package @netceterapx/click-to-pay-sdk (version pinned in package.json).
# Change only if the SDK is loaded from a different URL.
CTP_SDK_URL=/vendor/click-to-pay-sdk.js
# Mastercard: issued by Netcetera / Mastercard during onboarding
CTP_SRC_INITIATOR_ID=
CTP_SRCI_DPA_ID=
CTP_DPA_NAME=Click to Pay Demo
# Format language_COUNTRY, e.g. en_US
CTP_LOCALE=en_US
# Log scheme requests and responses to the console (works only in sandbox mode)
CTP_DEBUG_LOGS=false
